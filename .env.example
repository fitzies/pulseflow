# Shared bearer token for /api/cron/* and the Railway worker
CRON_SECRET=

# Public app URL used by the Railway scheduler, e.g. https://pulseflow.vercel.app
APP_URL=

# Public Railway worker URL used by /api/cron/run-scheduled
WORKER_URL=

# Optional: delete Execution rows older than this many days (default 7). Used by /api/cron/cleanup-executions.
EXECUTION_RETENTION_DAYS=7

# 32 random bytes as 64 hex chars, used to encrypt automation wallet keys (v2).
# Generate with: openssl rand -hex 32. Must be identical on Vercel and Railway.
WALLET_ENCRYPTION_KEY=
