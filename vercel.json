{
  "buildCommand": "npx prisma generate && next build",
  "installCommand": "pnpm install --frozen-lockfile",
  "crons": [
    {
      "path": "/api/cron/run-scheduled",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/cleanup-executions",
      "schedule": "0 3 * * *"
    }
  ]
}
